package strallcodes;

public class reverseSentenceeachusingtwopointertechnique {

    public static void main(String[] args) {

        String s = "farhan iqra loves eachother somuch";

        StringBuilder sb = new StringBuilder(s);

        sb.append(" ");

        int i = 0;
        int j = 0;

        while (j < sb.length()) {

            if (sb.charAt(j) == ' ') {

                reversefkingsentence(sb, i, j - 1);

                i = j + 1;
            }

            j++;
        }

        System.out.println(sb);
    }

    public static void reversefkingsentence(StringBuilder sb, int i, int j) {

        while (i < j) {

            char tempi = sb.charAt(i);
            char tempj = sb.charAt(j);

            sb.setCharAt(i, tempj);
            sb.setCharAt(j, tempi);

            i++;
            j--;
        }
    }
}

import java.util.HashMap;

class Solution {
    public int majorityElement(int[] nums) {
        HashMap<Integer, Integer> map = new HashMap<>();
        int n = nums.length;

        for (int num : nums) {
            map.put(num, map.getOrDefault(num, 0) + 1);

            // Agar count n/2 se zyada ho gaya, return kar do
            if (map.get(num) > n / 2) {
                return num;
            }
        }

        return -1; // ye case kabhi aayega nahi, kyunki problem guarantee karti hai
    }
}
